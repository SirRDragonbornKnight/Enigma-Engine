{
    "name": "Voice Mod",
    "id": "voice",
    "version": "2.0.0",
    "description": "Unified speech-to-text and text-to-speech service using local faster-whisper (STT) and Kokoro-82M (TTS). 100% local - no cloud calls.",
    "author": "Enigma AI Engine",
    "port": 9907,
    "commands": [
        {
            "name": "listen",
            "description": "Listen from microphone and return transcribed text via faster-whisper",
            "args": {
                "duration": {"type": "number", "required": false, "description": "Seconds to listen (default 5)"},
                "language": {"type": "string", "required": false, "description": "Language code (auto-detect if omitted)"}
            }
        },
        {
            "name": "speak",
            "description": "Speak text via the active TTS provider (default: Kokoro local)",
            "args": {
                "text": {"type": "string", "required": true, "description": "Text to speak aloud"}
            }
        },
        {
            "name": "transcribe",
            "description": "Transcribe an audio file to text via faster-whisper",
            "args": {
                "audio_path": {"type": "string", "required": true, "description": "Path to audio file (wav/mp3/flac/ogg)"},
                "language": {"type": "string", "required": false, "description": "Language code (auto-detect if omitted)"}
            }
        },
        {
            "name": "generate_audio",
            "description": "Generate a 24 kHz WAV file from text via Kokoro",
            "args": {
                "text": {"type": "string", "required": true, "description": "Text to convert to audio"},
                "out_path": {"type": "string", "required": false, "description": "Output WAV path (default outputs/voice/speech_<ts>.wav)"}
            }
        },
        {
            "name": "generate",
            "description": "Alias for generate_audio",
            "args": {
                "text": {"type": "string", "required": true, "description": "Text to convert to audio"}
            }
        },
        {
            "name": "start_continuous",
            "description": "Start continuous microphone listening in background",
            "args": {
                "chunk_sec": {"type": "number", "required": false, "description": "Seconds per chunk (default 5)"},
                "language": {"type": "string", "required": false, "description": "Language code"}
            }
        },
        {
            "name": "stop_continuous",
            "description": "Stop continuous microphone listening"
        },
        {
            "name": "set_voice",
            "description": "Set TTS voice (Kokoro voice name, e.g. af_heart, am_adam)",
            "args": {
                "voice": {"type": "string", "required": true, "description": "Kokoro voice name"}
            }
        },
        {
            "name": "set_rate",
            "description": "Set speech rate (Kokoro speed multiplier, 0.5-2.0)",
            "args": {
                "rate": {"type": "number", "required": true, "description": "Speed multiplier"}
            }
        },
        {
            "name": "set_volume",
            "description": "Set speech volume (0.0 to 1.0)",
            "args": {
                "volume": {"type": "number", "required": true, "description": "Volume level"}
            }
        },
        {
            "name": "list_voices",
            "description": "List available Kokoro voices"
        },
        {
            "name": "load_provider",
            "description": "Load a STT or TTS provider",
            "args": {
                "kind": {"type": "string", "required": true, "description": "'stt' or 'tts'"},
                "name": {"type": "string", "required": true, "description": "Provider name"}
            }
        },
        {
            "name": "unload_provider",
            "description": "Unload the active STT or TTS provider",
            "args": {
                "kind": {"type": "string", "required": true, "description": "'stt' or 'tts'"}
            }
        },
        {
            "name": "list_providers",
            "description": "List supported STT and TTS providers"
        },
        {
            "name": "set_default",
            "description": "Set default STT or TTS provider",
            "args": {
                "kind": {"type": "string", "required": true, "description": "'stt' or 'tts'"},
                "name": {"type": "string", "required": true, "description": "Provider name"}
            }
        },
        {
            "name": "load",
            "description": "Load STT and TTS pipelines"
        },
        {
            "name": "status",
            "description": "Get service and pipeline status"
        }
    ],
    "ui": {
        "layout": "vertical",
        "widgets": [
            {"type": "text_area", "id": "text", "label": "Text", "placeholder": "Enter text to speak..."},
            {"type": "dropdown", "id": "provider", "label": "TTS Provider", "options": ["local", "system"], "default": "local"},
            {"type": "button", "id": "listen", "label": "Listen", "command": "listen"},
            {"type": "button", "id": "speak", "label": "Speak", "command": "speak"},
            {"type": "button", "id": "generate_audio", "label": "Generate Audio", "command": "generate_audio"},
            {"type": "button", "id": "transcribe", "label": "Transcribe", "command": "transcribe"}
        ]
    },
    "prompt": "For voice/audio tasks, use: mod.send voice listen, mod.send voice speak <text>, mod.send voice generate_audio <text>, mod.send voice transcribe <audio_path>. TTS provider defaults to 'local' (Kokoro); 'system' is an OS-native fallback.",
    "rules": [
        "Use this single voice mod for both speech-to-text (faster-whisper) and text-to-speech (Kokoro).",
        "Prefer 'local' (Kokoro) for TTS; 'system' is opt-in OS-native fallback.",
        "All processing is local - no cloud calls."
    ],
    "dependencies": ["faster_whisper", "kokoro", "sounddevice", "soundfile", "numpy"],
    "settings": {
        "stt_engine": "whisper",
        "tts_engine": "local",
        "default_provider": "local",
        "whisper_model": "base",
        "whisper_device": "auto",
        "kokoro_voice": "af_heart",
        "kokoro_lang_code": "a",
        "mic_sample_rate": 16000,
        "mic_chunk_sec": 5.0,
        "output_dir": "outputs/voice"
    }
}
