{
    "name": "My Mod",
    "id": "mymod",
    "version": "1.0.0",
    "description": "Description of what this mod does",
    "author": "Your Name",
    "port": 9901,
    "commands": [
        {
            "name": "generate",
            "description": "Main generation command",
            "args": {
                "prompt": {"type": "string", "required": true, "description": "Input prompt"},
                "options": {"type": "object", "required": false, "description": "Optional settings"}
            }
        },
        {
            "name": "status",
            "description": "Get mod status"
        },
        {
            "name": "stop",
            "description": "Stop the mod"
        }
    ],
    "ui": {
        "layout": "vertical",
        "widgets": [
            {"type": "text_input", "id": "prompt", "label": "Prompt"},
            {"type": "dropdown", "id": "mode", "label": "Mode", "options": ["Default", "Fast", "Quality"], "default": "Default"},
            {"type": "checkbox", "id": "verbose", "label": "Verbose output", "default": false},
            {"type": "button", "id": "generate", "label": "Generate", "command": "generate"}
        ]
    },
    "prompt": "For mymod tasks, use: mod.send mymod generate <prompt>",
    "dependencies": [],
    "settings": {
        "example_setting": "value"
    }
}
