{
    "name": "Video Generation Mod",
    "id": "videogen",
    "version": "1.0.0",
    "description": "AI video generation from text prompts using CogVideoX-5B (local) or built-in animated GIF placeholder",
    "author": "Enigma AI Engine",
    "port": 9903,
    "commands": [
        {
            "name": "generate",
            "description": "Generate a video from a text prompt",
            "args": {
                "prompt": {"type": "string", "required": true, "description": "Text description of the video to generate"},
                "frames": {"type": "integer", "required": false, "default": 16, "description": "Number of frames to generate"},
                "width": {"type": "integer", "required": false, "default": 256, "description": "Video width in pixels"},
                "height": {"type": "integer", "required": false, "default": 256, "description": "Video height in pixels"},
                "provider": {"type": "string", "required": false, "description": "Provider to use (builtin, animatediff)"}
            }
        },
        {
            "name": "load_provider",
            "description": "Load a video generation provider",
            "args": {
                "provider": {"type": "string", "required": false, "description": "Provider name to load"}
            }
        },
        {
            "name": "unload_provider",
            "description": "Unload a video generation provider",
            "args": {
                "provider": {"type": "string", "required": false, "description": "Provider name to unload"}
            }
        },
        {
            "name": "list_providers",
            "description": "List available video generation providers and their status"
        },
        {
            "name": "set_default",
            "description": "Set the default video generation provider",
            "args": {
                "provider": {"type": "string", "required": true, "description": "Provider name to set as default"}
            }
        },
        {
            "name": "status",
            "description": "Get service status and loaded providers"
        }
    ],
    "ui": {
        "layout": "vertical",
        "widgets": [
            {"type": "text_area", "id": "prompt", "label": "Video Prompt", "placeholder": "Describe the video you want to generate..."},
            {"type": "number_input", "id": "frames", "label": "Frames", "default": 16, "min": 4, "max": 120},
            {"type": "dropdown", "id": "provider", "label": "Provider", "options": ["builtin", "animatediff"]},
            {"type": "button", "id": "generate", "label": "Generate", "command": "generate"}
        ]
    },
    "prompt": "For video generation, use: mod.send videogen generate <prompt> --frames 16",
    "dependencies": ["pillow"],
    "settings": {
        "default_provider": "builtin",
        "output_dir": "outputs/videos"
    }
}
